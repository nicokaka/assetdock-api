# =============================================================================
# AssetDock — Self-Hosted Configuration (Developer Build)
# =============================================================================
# Copy this file to .env.selfhosted and fill in your values.
# Then run: docker compose -f docker-compose.selfhosted.yml --env-file .env.selfhosted up -d
#
# On first access, the setup wizard will create the organization and admin account.
# =============================================================================

# --- Database ----------------------------------------------------------------
POSTGRES_DB=assetdock
POSTGRES_USER=assetdock
POSTGRES_PASSWORD=CHANGE_ME_USE_A_STRONG_PASSWORD

# --- Security ----------------------------------------------------------------
# Generate a random string with at least 32 characters.
# Example: openssl rand -base64 48
JWT_SECRET=CHANGE_ME_GENERATE_WITH_openssl_rand_base64_48
JWT_ISSUER=assetdock-api

# --- Web Session Cookies -----------------------------------------------------
# Set to true and Same-Site to None when serving via HTTPS with a domain.
WEB_SESSION_SECURE_COOKIES=false
WEB_SESSION_COOKIE_SAME_SITE=Lax

# --- Frontend ----------------------------------------------------------------
# The public URL where users access the web interface.
# Used for CORS and cookie scoping.
FRONTEND_URL=http://localhost:3000
WEB_PORT=3000
