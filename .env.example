# Banco de Dados
DB_URL=jdbc:postgresql://localhost:5432/assetdock
DB_USERNAME=assetdock
DB_PASSWORD=assetdock
DB_POOL_SIZE=10
DB_MIN_IDLE=2
DB_CONNECTION_TIMEOUT_MS=30000

# Segurança
JWT_SECRET=dev-only-secret-min-32-chars-replace-in-prod
JWT_ISSUER=assetdock-api
JWT_ACCESS_TOKEN_TTL=PT15M

# Sessão Web
WEB_SESSION_IDLE_TIMEOUT=PT30M
WEB_SESSION_ABSOLUTE_LIFETIME=PT8H
WEB_SESSION_SECURE_COOKIES=false
WEB_SESSION_COOKIE_SAME_SITE=Lax

# Servidor
SERVER_PORT=8080
MANAGEMENT_PORT=8081
LOCAL_FRONTEND_ORIGINS=http://localhost:5173,http://localhost:3000
PUBLIC_DOCS_ENABLED=false

# Throttle (desabilitado em dev)
THROTTLE_ENABLED=false

# Inicializacao
LOCAL_SEED_ENABLED=false
LOCAL_SEED_ORG_NAME=
LOCAL_SEED_ORG_SLUG=
LOCAL_SEED_ADMIN_FULL_NAME=
LOCAL_SEED_ADMIN_EMAIL=
LOCAL_SEED_ADMIN_PASSWORD=
