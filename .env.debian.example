# =============================================================================
# AssetDock — Debian Server Deployment (IP: 192.168.97.10 | Port: 5003)
# =============================================================================
# Copy this file to .env.selfhosted on your Debian server (/opt/assetdock/assetdock-api/.env.selfhosted)
# =============================================================================

# --- Network & Server Access -------------------------------------------------
WEB_PORT=5003
FRONTEND_URL=http://192.168.97.10:5003

# --- Database ----------------------------------------------------------------
POSTGRES_DB=assetdock
POSTGRES_USER=assetdock
POSTGRES_PASSWORD=CHANGE_THIS_TO_A_SECURE_PASSWORD_123!

# --- Security ----------------------------------------------------------------
# Generate a random secret (at least 32 characters):
JWT_SECRET=CHANGE_THIS_JWT_SECRET_KEY_MINIMUM_32_CHARACTERS_LONG
JWT_ISSUER=assetdock-api

# --- Web Session Cookies -----------------------------------------------------
WEB_SESSION_SECURE_COOKIES=false
WEB_SESSION_COOKIE_SAME_SITE=Lax

# --- Initial Setup / Seeding ------------------------------------------------
# Set SEED_ENABLED=true for first run if you want auto-admin creation
SEED_ENABLED=true
SEED_ORG_NAME=Sua Empresa
SEED_ORG_SLUG=sua-empresa
SEED_ADMIN_FULL_NAME=Administrador
SEED_ADMIN_EMAIL=admin@empresa.com.br
SEED_ADMIN_PASSWORD=Admin123!
