# =============================================================================
# AssetDock — Client Environment Configuration
# =============================================================================
# This file configures your AssetDock deployment.
# Copy this file to .env and fill in your values before running:
#   docker compose -f docker-compose.client.yml up -d
#
# Only JWT_SECRET is strictly required. All other values have safe defaults.
# =============================================================================

# --- Security (required) -----------------------------------------------------
# Generate a strong random secret:
#   Linux/macOS:  openssl rand -base64 48
#   Windows:      PowerShell: [Convert]::ToBase64String((1..48 | ForEach-Object { [byte](Get-Random -Max 256) }))
JWT_SECRET=REPLACE_WITH_A_STRONG_RANDOM_SECRET_MIN_32_CHARS

# --- Database password -------------------------------------------------------
# Strong password for the internal PostgreSQL database.
# This database is not exposed to the network — it's internal to Docker only.
DB_PASSWORD=REPLACE_WITH_A_STRONG_DB_PASSWORD

# --- Network -----------------------------------------------------------------
# The port users will access the application on.
# Default: 3000  (http://localhost:3000)
WEB_PORT=3000

# The public URL of your web interface.
# If accessing from other machines, replace localhost with your machine's IP.
# Example: http://192.168.1.100:3000
FRONTEND_URL=http://localhost:3000
